{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Signyd Docs",
  "colors": {
    "primary": "#146EF5",
    "light": "#146EF5",
    "dark": "#0059DB"
  },
  "favicon": {
    "light": "/images/signyd-com-icon.svg",
    "dark": "/images/signyd-com-icon.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Platform",
          "icon": "signature",
          "href": "https://signyd.com/platform"
        },
        {
          "anchor": "Blog",
          "href": "https://signyd.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Docs",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "index",
                  "accounts",
                  "first-document"
                ]
              },
              {
                "group": "Workspace",
                "pages": [
                  "workspace/home",
                  "workspace/roles",
                  "workspace/languages"
                ]
              },
              {
                "group": "Documents",
                "pages": [
                  "documents/list",
                  "documents/prepare",
                  "documents/fields",
                  "documents/detail"
                ]
              },
              {
                "group": "Library",
                "pages": [
                  "templates/overview",
                  "contacts/overview"
                ]
              },
              {
                "group": "Signing and verification",
                "pages": [
                  "signing/recipient",
                  "verify/identity",
                  "verify/public-page"
                ]
              },
              {
                "group": "Settings",
                "pages": [
                  "settings/team",
                  "settings/branding",
                  "settings/billing",
                  "settings/account-security"
                ]
              },
              {
                "group": "Developers",
                "pages": [
                  "developers/api",
                  "developers/webhooks"
                ]
              }
            ]
          },
          {
            "tab": "Legal",
            "groups": [
              {
                "group": "Legal",
                "pages": [
                  "legal/terms",
                  "legal/privacy",
                  "legal/cookie",
                  "legal/security",
                  "verify",
                  "signature"
                ],
                "expanded": true
              }
            ]
          }
        ]
      },
      {
        "language": "es",
        "tabs": [
          {
            "tab": "Docs",
            "groups": [
              {
                "group": "Primeros pasos",
                "pages": [
                  "es/index",
                  "es/accounts",
                  "es/first-document"
                ]
              },
              {
                "group": "Workspace",
                "pages": [
                  "es/workspace/home",
                  "es/workspace/roles",
                  "es/workspace/languages"
                ]
              },
              {
                "group": "Documentos",
                "pages": [
                  "es/documents/list",
                  "es/documents/prepare",
                  "es/documents/fields",
                  "es/documents/detail"
                ]
              },
              {
                "group": "Biblioteca",
                "pages": [
                  "es/templates/overview",
                  "es/contacts/overview"
                ]
              },
              {
                "group": "Firma y verificación",
                "pages": [
                  "es/signing/recipient",
                  "es/verify/identity",
                  "es/verify/public-page"
                ]
              },
              {
                "group": "Ajustes",
                "pages": [
                  "es/settings/team",
                  "es/settings/branding",
                  "es/settings/billing",
                  "es/settings/account-security"
                ]
              },
              {
                "group": "Desarrolladores",
                "pages": [
                  "es/developers/api",
                  "es/developers/webhooks"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/signyd-brand.svg",
    "dark": "/images/signyd-com-icon.svg",
    "href": "https://signyd.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@signyd.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.signyd.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  }
}
