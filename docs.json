{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Signyd Docs",
  "colors": {
    "primary": "#146EF5",
    "light": "#146EF5",
    "dark": "#0059DB"
  },
  "favicon": {
    "light": "/images/signyd-com-icon.svg",
    "dark": "/images/signyd-com-icon.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Platform",
          "icon": "signature",
          "href": "https://signyd.com/platform"
        },
        {
          "anchor": "Blog",
          "href": "https://signyd.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "Accounts",
              "first-document"
            ]
          }
        ]
      },
      {
        "tab": "Legal",
        "groups": [
          {
            "group": "Legal",
            "pages": [
              "legal/terms",
              "legal/privacy",
              "legal/cookie",
              "legal/security",
              "verify",
              "signature"
            ],
            "expanded": true
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/signyd-brand.svg",
    "dark": "/images/signyd-com-icon.svg",
    "href": "https://signyd.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@signyd.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.signyd.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  }
}
